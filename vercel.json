{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://3.6.44.45:5004/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://3.6.44.45:5004/uploads/:path*"
    },
    {
      "source": "/temp/:path*",
      "destination": "http://3.6.44.45:5004/temp/:path*"
    },
    {
      "source": "/((?!api|uploads|temp).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" }
      ]
    }
  ]
}
